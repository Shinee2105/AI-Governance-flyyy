# =============================================================================
# Flyyy.ai backend - environment configuration
# Copy this file to `.env` and fill in the placeholders.
# NEVER commit your real .env (it is git-ignored).
# =============================================================================

# ---- Core ----
ENVIRONMENT=development
APP_NAME=Flyyy.ai - SaaS AI Governance

# ---- Database ----
# Default: local SQLite file (works out-of-the-box, no setup).
DATABASE_URL=sqlite:///./flyyy.db
# Production example (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/flyyy

# ---- Security (REPLACE before any real deployment) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_admin_2025
SECRET_KEY=dev-secret-key-please-change-in-production
TOKEN_EXPIRE_MINUTES=1440

# ---- CORS ----
# Comma-separated list of allowed frontend origins. In development this is the
# Vite dev server. In production set it to your deployed frontend origin.
# Never use "*" together with credentials.
BACKEND_CORS_ORIGINS=http://localhost:5173

# ---- Demo data ----
# When true, the app seeds realistic SIMULATED data so it runs without SaaS creds.
SEED_DEMO_DATA=true

# ---- Microsoft 365 connector (OPTIONAL - fill to discover REAL evidence) ----
# 1. Register an Azure AD app (Entra ID) in your tenant.
# 2. Grant Graph app permissions: Directory.Read.All, User.Read.All,
#    Organization.Read.All (for discovery) and the Office 365 Management API
#    (ActivityFeed.Read) for monitoring. Admin-consent the permissions.
# 3. Create a client secret and paste the values below, then set
#    MS365_ENABLED=true.
MS365_ENABLED=false
MS365_TENANT_ID=YOUR_TENANT_ID
MS365_CLIENT_ID=YOUR_APP_CLIENT_ID
MS365_CLIENT_SECRET=YOUR_APP_CLIENT_SECRET
# Optional: separate credentials for the Office 365 Management Activity API.
# If omitted, the Graph credentials above are reused.
MS365_MANAGEMENT_API_CLIENT_ID=
MS365_MANAGEMENT_API_CLIENT_SECRET=
