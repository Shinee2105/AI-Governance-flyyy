# Frontend environment (Vite reads VITE_-prefixed vars at build/dev time).
# These are DEVELOPMENT conveniences only and are NOT required in production.

# Enable silent dev auto-login with the dev credentials below.
# Set to "false" to force the manual login screen (recommended when demoing
# the auth flow, or in any shared/production-like environment).
VITE_AUTH_DEV_AUTOLOGIN=true

# Default dev admin account used by auto-login. Override for local testing.
VITE_DEV_ADMIN_USER=admin
VITE_DEV_ADMIN_PASSWORD=CHANGE_ME_admin_2025
